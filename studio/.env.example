# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Browser that is logged in to Instagram/TikTok, so yt-dlp can download references: chrome|firefox|edge|safari
STUDIO_COOKIES_BROWSER=chrome
# whisper model for captions: tiny|base|small|medium|large-v3  (small is a good CPU default)
STUDIO_WHISPER_MODEL=small
STUDIO_LANGUAGE=id
