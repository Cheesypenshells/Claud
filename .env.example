# Dapatkan API key di https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# Fast mode Claude: balasan sampai ~2,5x lebih cepat, harga per token 2x lipat.
# Ubah ke false untuk menghemat biaya.
FAST_MODE=true

# Berita harian otomatis (web search Claude). false = hanya saat dibuka. Kategori bisa dibatasi, mis. NEWS_CATEGORIES=indonesia,dunia,ekonomi
NEWS_AUTO=true
