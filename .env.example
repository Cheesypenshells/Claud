# Salin file ini menjadi ".env" lalu isi. File .env JANGAN dibagikan / di-commit.

# ID WhatsApp owner (boleh lebih dari satu, pisahkan koma).
# Cara tahu: setelah bot jalan, ketik #idsaya di grup mana pun yang ada botnya.
OWNER_IDS=6281234567890

# Nomor WhatsApp khusus bot (format 62...). Jika diisi, bot login memakai kode pairing 8 digit.
# Jika dikosongkan, bot menampilkan QR code di layar untuk di-scan.
NOMOR_BOT=

# Google Sheets: ID spreadsheet (bagian URL di antara /d/ dan /edit)
SPREADSHEET_ID=
# File kunci service account Google (lihat docs/SETUP.md)
GOOGLE_KEY_FILE=credentials.json

# Opsional: API key Claude untuk membaca foto bukti transfer / nota.
# Kosongkan jika tidak dipakai; bot akan meminta nominal diketik.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Jadwal otomatis (WIB). Kosongkan untuk mematikan.
JAM_PENGINGAT_OMZET=23:00
JAM_REKAP_MALAM=23:30
JAM_PENGINGAT_TRANSFER=10:00
