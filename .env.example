# Dapatkan API key di https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# Model AI. Default claude-haiku-5-5 (paling hemat, ~40x lebih murah dari Opus).
# Ganti ke claude-opus-5-5 kalau ingin obrolan yang lebih pintar & luwes (lebih mahal).
CLAUDE_MODEL=claude-haiku-5-5

# Fast mode: hanya untuk claude-opus-5-5, harga 2x. Biarkan false untuk hemat.
FAST_MODE=false

# Berita harian otomatis (memakai pencarian web, berbayar). false = berita baru dicari saat tab Berita dibuka.
# Kategori bisa dibatasi, mis. NEWS_CATEGORIES=indonesia,dunia,ekonomi
NEWS_AUTO=false
